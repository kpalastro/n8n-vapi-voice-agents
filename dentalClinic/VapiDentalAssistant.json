              "value": "{\n  \"model\": {\n    \"provider\": \"openai\",\n    \"model\": \"gpt-4o-mini\",\n    \"messages\": [\n      {\n        \"role\": \"system\",\n        \"content\": \"This is a blank template with minimal defaults, you can change the model, temperature, and messages.\"\n      }\n    ],\n    \"maxTokens\": 90,\n    \"emotionRecognitionEnabled\": false,\n    \"tools\": [\n      {\n        \"type\": \"function\",\n        \"server\": {\n          \"url\": \"https://aiagency.app.n8n.cloud/webhook/vapi\"\n        },\n        \"function\": {\n          \"name\": \"Dental_clinic\",\n          \"description\": \"This tool is used to retrieve information related to dental clinic and their services\",\n          \"parameters\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"dental_query\": {\n                \"type\": \"string\",\n                \"description\": \"Use as key to search in database information\"\n              }\n            }\n          }\n        }\n      }\n    ],\n    \n  },\n  \"voice\": {\n    \"provider\": \"11labs\",\n    \"voiceId\": \"sarah\",\n    \"model\": \"eleven_multilingual_v2\",\n    \"useSpeakerBoost\": false\n  },\n  \"firstMessage\": \"Hi I am Sarah how can I help you?\",\n  \"transcriber\": {\n    \"provider\": \"deepgram\",\n    \"model\": \"nova-2\",\n    \"language\": \"en\"\n  },\n  \"serverMessages\": [\n    \"end-of-call-report\",\n    \"function-call\",\n    \"tool-calls\"\n  ],\n  \"analysisPlan\": {\n    \"summaryPlan\": {\n      \"enabled\": false,\n      \"messages\": [\n        \n      ],\n      \"timeoutSeconds\": 1\n    },\n    \"structuredDataPlan\": {\n      \"enabled\": false\n    }\n  }\n}",
