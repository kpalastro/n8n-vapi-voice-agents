        "jsCode": "function sanitizeJSON(jsonString) {\n    // Replace problematic quotes and newlines within the JSON string\n    return jsonString\n        .replace(/\"([^\"]*?)\"/g, (match, group) => {\n            // Ensure keys and properly quoted values remain intact\n            if (/:$/.test(match) || /^[\\s\\[{\"]/.test(match)) {\n                return match; // Leave valid JSON quotes untouched\n            }\n            // Escape any other problematic quotes\n            return `\"${group.replace(/\"/g, '\\\\\"')}\"`;\n        })\n        //.replace(/\\n/g, \" \"); // Replace \\n with a space or any desired character\n}\n\nreturn {\n  output:sanitizeJSON($json.output.replace(/\\n/g, \" \").replace(/\\\"/g, ' \\\\\"'))\n}"
